@model DayRun.Web.ViewModels.EventViewModel
<form asp-action="CreateEvent" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label>Event Name</label>
        <input asp-for="Name" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Date</label>
        <input asp-for="Date" type="date" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Event Banner Image</label>
        <input type="file" name="Banner" class="form-control" accept="image/*" />
    </div>
    <!-- Add other fields (Location, Distance, EventType) -->
    <button type="submit" class="btn btn-primary mt-3">Create Event</button>
</form>