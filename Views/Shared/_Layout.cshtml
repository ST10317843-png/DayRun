@page
@model DayRun.Views.Shared._LayoutModel
@{
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@ViewData["Title"] - DayRun</title>
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    </head>
    <body>
        <header>
            <nav class="navbar navbar-expand-sm navbar-dark bg-dark">
                <div class="container-fluid">
                    <a class="navbar-brand text-warning fw-bold" asp-controller="Home" asp-action="Index">DayRun</a>
                    <div class="collapse navbar-collapse">
                        <ul class="navbar-nav flex-grow-1">
                            @if (Context.Session.GetString("Role") == "Organiser")
                            {
                                <li class="nav-item"><a class="nav-link text-white" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a></li>
                            }
                            else if (Context.Session.GetString("Role") == "Participant")
                            {
                                <li class="nav-item"><a class="nav-link text-white" asp-controller="Participant" asp-action="Index">Find Events</a></li>
                                <li class="nav-item"><a class="nav-link text-white" asp-controller="Participant" asp-action="MyEvents">My Enrolments</a></li>
                                <li class="nav-item"><a class="nav-link text-white" asp-controller="Participant" asp-action="MyResults">My Results</a></li>
                            }
                        </ul>
                        <ul class="navbar-nav">
                            @if (Context.Session.GetString("UserId") != null)
                            {
                                <li class="nav-item"><a class="nav-link text-warning" href="/Account/Logout">Logout (@Context.Session.GetString("Name"))</a></li>
                            }
                            else
                            {
                                <li class="nav-item"><a class="nav-link text-white" href="/Account/Login">Login</a></li>
                                <li class="nav-item"><a class="nav-link text-white" href="/Account/Register">Register</a></li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
        <div class="container mt-4">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>
    </html>
}
