@page
@model DayRun.Views.Shared._LayoutModel
@{
    <ul class="navbar-nav flex-grow-1">
        @if (Context.Session.GetString("Role") == "Organiser")
        {
            <li class="nav-item"><a class="nav-link text-white" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a></li>
            <li class="nav-item"><a class="nav-link text-white" asp-controller="Organiser" asp-action="Events">Manage Events</a></li>
        }
        else if (Context.Session.GetString("Role") == "Participant")
        {
            <li class="nav-item"><a class="nav-link text-white" asp-controller="Participant" asp-action="Index">Find Events</a></li>
            <li class="nav-item"><a class="nav-link text-white" asp-controller="Participant" asp-action="MyEvents">My Enrolments</a></li>
            <li class="nav-item"><a class="nav-link text-white" asp-controller="Participant" asp-action="MyResults">My Results</a></li>
        }
    </ul>
    <ul class="navbar-nav">
        @if (Context.Session.GetString("UserId") != null)
        {
            <li class="nav-item"><a class="nav-link text-warning" href="/Account/Logout">Logout (@Context.Session.GetString("Name"))</a></li>
        }
        else
        {
            <li class="nav-item"><a class="nav-link text-white" href="/Account/Login">Login</a></li>
        }
    </ul>
}
